# Base de datos (Neon Postgres)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Secreto para firmar cookies de sesión (generar: openssl rand -hex 32)
AUTH_SECRET="replace-with-random-secret"

# Google OAuth Client ID — el mismo valor va en ambas variables
# VITE_ se expone al navegador (botón GIS); la otra valida audiencia en el servidor
GOOGLE_CLIENT_ID="replace-with-google-client-id"
VITE_GOOGLE_CLIENT_ID="replace-with-google-client-id"

# URL pública del sitio (SEO, sitemap, canonical)
SITE_URL="http://localhost:3000"
VITE_SITE_URL="http://localhost:3000"

# Google Analytics 4 (opcional)
VITE_GA_ID=""

# SMTP (opcional, notificaciones futuras)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="no-reply@example.com"
SMTP_PASS="replace-with-smtp-password"
