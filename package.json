    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv": "^17.2.3",
    "jsdom": "^27.0.0",
    "prisma": "^7.0.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.9.2",
    "vite": "^8.0.14",
    "vitest": "^4.1.4"
