{
  "name": "limacentro",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "start": "bun run server.ts",
